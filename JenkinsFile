pipeline {

    agent any

    stages {

        stage('Compile') {
            steps {
                dir('student-management-api') {
                    bat 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('student-management-api') {
                    bat 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('student-management-api') {
                    bat 'mvn package -DskipTests'
                }
            }
        }

        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: 'student-management-api/target/*.jar', fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'CI Pipeline completed successfully!'
        }

        failure {
            echo 'CI Pipeline failed!'
        }
    }
}
